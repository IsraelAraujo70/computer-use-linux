{
  "mcpServers": {
    "computer-use-linux": {
      "command": "./bin/computer-use-linux",
      "args": [
        "mcp"
      ],
      "cwd": ".",
      "env_vars": [
        "DBUS_SESSION_BUS_ADDRESS",
        "DESKTOP_SESSION",
        "DISPLAY",
        "I3SOCK",
        "XAUTHORITY",
        "XDG_CACHE_HOME",
        "XDG_CURRENT_DESKTOP",
        "XDG_RUNTIME_DIR",
        "XDG_SESSION_DESKTOP",
        "XDG_SESSION_TYPE",
        "XDG_STATE_HOME",
        "COMPUTER_USE_LINUX_AGENT_NAME",
        "COMPUTER_USE_LINUX_BIN",
        "COMPUTER_USE_LINUX_DOWNLOAD_BASE",
        "COMPUTER_USE_LINUX_ENABLE_SHELL",
        "COMPUTER_USE_LINUX_XDOTOOL_TYPE_DELAY_MS"
      ]
    }
  }
}
